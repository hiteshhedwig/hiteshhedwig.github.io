---
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects
    .filter((p) => p.data.demoPath)
    .map((p) => ({
      params: { slug: p.id },
      props: { project: p },
    }));
}

const { project } = Astro.props;
const demoUrl = `/${project.data.demoPath}/index.html`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{project.data.title} — Demo</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Inter:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --cream: #faf7f2;
      --ink: #2c2418;
      --ink-light: #5c5347;
      --ink-lighter: #8a7f72;
      --accent: #c45d3e;
      --border: #e0d8cc;
      --bar-h: 48px;
    }

    html, body { height: 100%; overflow: hidden; background: var(--cream); }

    header {
      position: fixed;
      top: 0; left: 0; right: 0;
      height: var(--bar-h);
      background: var(--cream);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 0;
      z-index: 100;
      font-family: "Inter", sans-serif;
    }

    .bar-back {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0 1rem;
      height: 100%;
      font-size: 0.82rem;
      color: var(--ink-lighter);
      text-decoration: none;
      border-right: 1px solid var(--border);
      transition: color 0.15s, background 0.15s;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .bar-back:hover { color: var(--accent); background: #f5f0e8; }

    .bar-title {
      flex: 1;
      padding: 0 1.25rem;
      font-size: 0.88rem;
      font-weight: 500;
      color: var(--ink);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .bar-mono {
      font-family: "JetBrains Mono", monospace;
      font-size: 0.72rem;
      color: var(--ink-lighter);
      padding: 0 1rem;
      letter-spacing: 0.04em;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .bar-open {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0 1rem;
      height: 100%;
      font-size: 0.82rem;
      color: var(--ink-lighter);
      text-decoration: none;
      border-left: 1px solid var(--border);
      transition: color 0.15s, background 0.15s;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .bar-open:hover { color: var(--accent); background: #f5f0e8; }

    iframe {
      position: fixed;
      top: var(--bar-h);
      left: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      height: calc(100vh - var(--bar-h));
      border: 0;
    }

    .loading-overlay {
      position: fixed;
      top: var(--bar-h);
      inset: 0;
      top: var(--bar-h);
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--cream);
      z-index: 50;
      flex-direction: column;
      gap: 1rem;
      font-family: "JetBrains Mono", monospace;
      font-size: 0.82rem;
      color: var(--ink-lighter);
      letter-spacing: 0.06em;
      pointer-events: none;
      transition: opacity 0.4s;
    }
    .loading-dot {
      width: 6px; height: 6px;
      background: var(--accent);
      border-radius: 50%;
      display: inline-block;
      animation: pulse 1.4s ease-in-out infinite;
    }
    .loading-dot:nth-child(2) { animation-delay: 0.2s; }
    .loading-dot:nth-child(3) { animation-delay: 0.4s; }
    @keyframes pulse { 0%, 100% { opacity: 0.3; transform: scale(0.8); } 50% { opacity: 1; transform: scale(1); } }
  </style>
</head>
<body>
  <header>
    <a href="/demos" class="bar-back">&#8592; Demos</a>
    <span class="bar-title">{project.data.title}</span>
    <span class="bar-mono" id="bar-status">loading…</span>
    <a href={demoUrl} target="_blank" rel="noopener" class="bar-open">open in new tab &#8599;</a>
  </header>

  <div class="loading-overlay" id="loading">
    <div>
      <span class="loading-dot"></span>
      <span class="loading-dot"></span>
      <span class="loading-dot"></span>
    </div>
    <span>loading demo</span>
  </div>

  <iframe
    id="demo-frame"
    src={demoUrl}
    title={`${project.data.title} interactive demo`}
    allow="fullscreen"
  ></iframe>

  <script>
    const frame = document.getElementById('demo-frame') as HTMLIFrameElement;
    const loading = document.getElementById('loading') as HTMLElement;
    const status = document.getElementById('bar-status') as HTMLElement;

    frame.addEventListener('load', () => {
      loading.style.opacity = '0';
      setTimeout(() => loading.remove(), 400);
      status.textContent = 'interactive';
    });
    frame.addEventListener('error', () => {
      status.textContent = 'failed to load';
    });
  </script>
</body>
</html>
