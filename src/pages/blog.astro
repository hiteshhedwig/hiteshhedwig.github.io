---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const posts = [
  {
    title: "Why I Still Prefer C++ for Perception Pipelines",
    date: "March 12, 2026",
    summary:
      "Thoughts on when Python falls short and why reaching for C++ is worth the friction when milliseconds matter.",
    tags: ["Robotics", "C++", "Opinion"],
  },
  {
    title: "Notes on Sim-to-Real Transfer",
    date: "February 20, 2026",
    summary:
      "Lessons learned from months of trying to make simulated grasping work on real hardware. Domain randomization is not a silver bullet.",
    tags: ["Deep Learning", "Robotics"],
  },
  {
    title: "My Reading System for Research Papers",
    date: "January 8, 2026",
    summary:
      "A simple workflow involving Zotero, a tablet, and spaced repetition that finally made paper reading feel manageable.",
    tags: ["Workflow", "Research"],
  },
  {
    title: "Understanding Kalman Filters Intuitively",
    date: "November 15, 2025",
    summary:
      "An attempt to explain Kalman filtering without immediately jumping into matrix notation. Start with the idea, then the math.",
    tags: ["Perception", "Tutorial"],
  },
  {
    title: "Building a ROS2 Package from Scratch in 2025",
    date: "September 3, 2025",
    summary:
      "A no-nonsense walkthrough. CMakeLists, package.xml, colcon, and all the little gotchas nobody warns you about.",
    tags: ["ROS2", "Tutorial"],
  },
  {
    title: "Books That Changed How I Think About Engineering",
    date: "July 22, 2025",
    summary:
      "A short list of books outside the robotics canon that shaped my approach to building systems.",
    tags: ["Books", "Personal"],
  },
];
---

<Base title="Blog — Hitesh">
  <Nav />

  <main class="flex-1">
    <section class="max-w-3xl mx-auto px-6 pt-16 pb-12">
      <h1 class="font-serif text-3xl font-semibold mb-2">Blog</h1>
      <p class="text-ink-light mb-10">
        Writing helps me think. These are notes, tutorials, and opinions — mostly about robotics,
        perception, and the craft of building things.
      </p>

      <div class="space-y-1">
        {posts.map((post, i) => (
          <>
            <a href="#" class="group block py-4">
              <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6">
                <span class="text-sm text-ink-lighter font-mono shrink-0 w-36">{post.date}</span>
                <div class="flex-1">
                  <h2 class="font-medium group-hover:text-accent transition-colors">
                    {post.title}
                  </h2>
                  <p class="text-sm text-ink-light mt-1 leading-relaxed">{post.summary}</p>
                  <div class="flex gap-2 mt-2">
                    {post.tags.map((tag) => (
                      <span class="text-xs px-2 py-0.5 rounded-full bg-cream-dark text-ink-lighter">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </a>
            {i < posts.length - 1 && <hr class="border-border" />}
          </>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Base>
