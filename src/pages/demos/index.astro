---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects"))
  .filter((p) => p.data.demoPath)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base title="Demos — Hitesh">
  <Nav />

  <main class="flex-1">
    <section class="bg-cream">
      <div class="max-w-5xl mx-auto px-6 pt-16 pb-6">
        <h1 class="font-serif text-3xl font-semibold mb-2 fade-up">Demos</h1>
        <p class="text-ink-light fade-up fade-up-delay-1">
          Interactive visualizations from real projects — run directly in the browser.
        </p>
      </div>
    </section>

    <section class="bg-warm-white">
      <div class="max-w-5xl mx-auto px-6 py-10">
        {projects.length === 0 && (
          <p class="text-ink-lighter text-center py-16 font-serif italic">No demos yet.</p>
        )}
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((project, i) => {
            const images = (project.data.images ?? []).map((img) => img.src);
            const hasImages = images.length > 0;
            return (
              <div
                class:list={[
                  "group relative border border-border rounded-xl overflow-hidden bg-cream/60 hover:border-border-dark hover:shadow-xl hover:-translate-y-1.5 transition-all duration-200 cursor-pointer fade-up",
                  `fade-up-delay-${Math.min(i + 1, 3)}`,
                ]}
                data-demo-href={`/demo/${project.id}`}
                data-images={JSON.stringify(images)}
              >
                {/* Preview image area */}
                <div class="relative w-full bg-paper" style="height:200px;overflow:hidden;">
                  {hasImages ? (
                    images.map((src, j) => (
                      <img
                        src={src}
                        alt=""
                        class="demo-slide absolute inset-0 w-full h-full object-cover"
                        style={j === 0 ? "opacity:1;transition:opacity 0.7s ease;" : "opacity:0;transition:opacity 0.7s ease;"}
                      />
                    ))
                  ) : (
                    <div class="absolute inset-0 flex flex-col items-center justify-center gap-2">
                      <svg width="100%" height="100%" style="position:absolute;inset:0;opacity:0.06" aria-hidden="true">
                        <defs>
                          <pattern id={`grid-${project.id}`} width="24" height="24" patternUnits="userSpaceOnUse">
                            <path d="M 24 0 L 0 0 0 24" fill="none" stroke="#2c2418" stroke-width="0.5"/>
                          </pattern>
                        </defs>
                        <rect width="100%" height="100%" fill={`url(#grid-${project.id})`}/>
                      </svg>
                      <span class="relative font-mono text-4xl font-bold text-ink-lighter/30 select-none">
                        {project.data.title.split(/\s+/).filter(Boolean).slice(0, 3).map((w) => w[0]).join("")}
                      </span>
                      <span class="relative font-mono text-[10px] text-ink-lighter/40 uppercase tracking-widest">interactive demo</span>
                    </div>
                  )}
                  {/* Hover play overlay */}
                  <div class="absolute inset-0 bg-ink/0 group-hover:bg-ink/20 transition-colors duration-200 flex items-center justify-center">
                    <span class="opacity-0 group-hover:opacity-100 transition-all duration-200 scale-95 group-hover:scale-100 bg-ink/75 text-cream text-sm font-medium px-4 py-2 rounded-lg backdrop-blur-sm">
                      Launch &#8594;
                    </span>
                  </div>
                </div>

                {/* Card footer */}
                <div class="px-4 py-3 flex items-center justify-between gap-3">
                  <div class="min-w-0">
                    <p class="font-serif font-medium text-ink group-hover:text-accent transition-colors text-sm leading-snug truncate">
                      {project.data.title}
                    </p>
                    <div class="flex gap-1.5 flex-wrap mt-1.5">
                      {project.data.tags.slice(0, 3).map((tag) => (
                        <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-cream-dark text-ink-lighter">
                          {tag}
                        </span>
                      ))}
                    </div>
                  </div>
                  <a
                    href={`/projects/${project.id}`}
                    class="text-xs text-ink-lighter hover:text-accent transition-colors shrink-0"
                    onclick="event.stopPropagation()"
                  >
                    &#8599;
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<script>
  const observer = new IntersectionObserver(
    (entries) => entries.forEach((e) => { if (e.isIntersecting) e.target.classList.add("visible"); }),
    { threshold: 0.1, rootMargin: "0px 0px -50px 0px" }
  );
  document.querySelectorAll(".fade-up").forEach((el) => observer.observe(el));

  // Card click → navigate to demo
  document.querySelectorAll<HTMLElement>("[data-demo-href]").forEach((card) => {
    card.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) return;
      window.location.href = card.dataset.demoHref!;
    });
  });

  // Slideshow: cycle images every 1.8s
  document.querySelectorAll<HTMLElement>("[data-images]").forEach((card) => {
    const srcs: string[] = JSON.parse(card.dataset.images || "[]");
    if (srcs.length < 2) return;
    const slides = card.querySelectorAll<HTMLElement>(".demo-slide");
    let current = 0;
    setInterval(() => {
      (slides[current] as HTMLElement).style.opacity = "0";
      current = (current + 1) % slides.length;
      (slides[current] as HTMLElement).style.opacity = "1";
    }, 1800);
  });
</script>
