---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

const featuredProjects = [
  {
    title: "Visual SLAM for Indoor Robots",
    description: "Real-time visual odometry and mapping system for mobile robots navigating cluttered indoor environments.",
    tags: ["C++", "ROS2", "OpenCV"],
    color: "bg-sky-light",
  },
  {
    title: "Grasp Pose Estimation",
    description: "Deep learning pipeline for predicting stable grasp poses from single RGB-D images.",
    tags: ["Python", "PyTorch", "Sim2Real"],
    color: "bg-sage-light",
  },
  {
    title: "LiDAR Object Tracker",
    description: "Multi-object tracking using 3D LiDAR point clouds with Kalman filtering and Hungarian assignment.",
    tags: ["Python", "PCL", "ROS"],
    color: "bg-accent-light/40",
  },
];

const recentPosts = [
  {
    title: "Why I Still Prefer C++ for Perception Pipelines",
    date: "March 2026",
    summary: "Thoughts on when Python falls short and why reaching for C++ is worth the friction.",
  },
  {
    title: "Notes on Sim-to-Real Transfer",
    date: "February 2026",
    summary: "Lessons learned from months of trying to make simulated grasping work on real hardware.",
  },
  {
    title: "My Reading System for Research Papers",
    date: "January 2026",
    summary: "A simple workflow that finally made paper reading feel manageable and enjoyable.",
  },
];
---

<Base>
  <Nav />

  <main class="flex-1">
    <!-- Hero -->
    <section class="max-w-3xl mx-auto px-6 pt-16 pb-12">
      <div class="space-y-6">
        <p class="text-ink-lighter text-sm font-mono">hello, world</p>
        <h1 class="font-serif text-4xl sm:text-5xl font-semibold leading-tight">
          I'm <span class="text-accent">Hitesh</span>.<br />
          I build things that<br />
          <span class="italic">see, think & move</span>.
        </h1>
        <p class="text-ink-light text-lg max-w-xl leading-relaxed">
          Roboticist and perception engineer. I love the intersection of cameras, code,
          and clever algorithms. This is my little corner of the internet where I share
          what I'm building and learning.
        </p>
        <div class="flex gap-4 pt-2">
          <a
            href="/projects"
            class="px-5 py-2.5 bg-ink text-cream rounded-lg text-sm font-medium hover:bg-ink-light transition-colors"
          >
            See my work
          </a>
          <a
            href="/about"
            class="px-5 py-2.5 border border-border-dark text-ink-light rounded-lg text-sm font-medium hover:border-ink-lighter hover:text-ink transition-colors"
          >
            More about me
          </a>
        </div>
      </div>
    </section>

    <!-- Divider -->
    <div class="max-w-3xl mx-auto px-6">
      <hr class="border-border" />
    </div>

    <!-- Featured Projects -->
    <section class="max-w-3xl mx-auto px-6 py-12">
      <div class="flex items-baseline justify-between mb-8">
        <h2 class="font-serif text-2xl font-semibold">Featured Projects</h2>
        <a href="/projects" class="text-sm text-ink-lighter hover:text-accent transition-colors">
          View all &rarr;
        </a>
      </div>
      <div class="grid gap-4">
        {featuredProjects.map((project) => (
          <a
            href="/projects"
            class="group block border border-border rounded-xl p-5 hover:border-border-dark hover:shadow-sm transition-all bg-warm-white"
          >
            <div class="flex items-start gap-4">
              <div class={`w-2 h-2 rounded-full mt-2.5 shrink-0 ${project.color}`} />
              <div class="space-y-2">
                <h3 class="font-medium group-hover:text-accent transition-colors">
                  {project.title}
                </h3>
                <p class="text-sm text-ink-light leading-relaxed">{project.description}</p>
                <div class="flex gap-2 flex-wrap">
                  {project.tags.map((tag) => (
                    <span class="text-xs font-mono px-2 py-0.5 rounded-md bg-cream-dark text-ink-lighter">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Divider -->
    <div class="max-w-3xl mx-auto px-6">
      <hr class="border-border" />
    </div>

    <!-- Recent Writing -->
    <section class="max-w-3xl mx-auto px-6 py-12">
      <div class="flex items-baseline justify-between mb-8">
        <h2 class="font-serif text-2xl font-semibold">Recent Writing</h2>
        <a href="/blog" class="text-sm text-ink-lighter hover:text-accent transition-colors">
          All posts &rarr;
        </a>
      </div>
      <div class="space-y-6">
        {recentPosts.map((post) => (
          <a href="/blog" class="group block">
            <div class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4">
              <span class="text-sm text-ink-lighter font-mono shrink-0">{post.date}</span>
              <div>
                <h3 class="font-medium group-hover:text-accent transition-colors">{post.title}</h3>
                <p class="text-sm text-ink-light mt-1">{post.summary}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Little note -->
    <section class="max-w-3xl mx-auto px-6 pb-16">
      <div class="bg-paper border border-border rounded-xl p-6 text-center">
        <p class="font-serif italic text-ink-light">
          "The best way to learn is to build something, break it, then write about it."
        </p>
        <p class="text-xs text-ink-lighter mt-2">— something I keep telling myself</p>
      </div>
    </section>
  </main>

  <Footer />
</Base>
