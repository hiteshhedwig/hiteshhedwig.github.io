---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.order - b.data.order
);

const TAG_PALETTES = [
  { bg: "rgba(196,93,62,0.12)",   color: "rgba(160,60,30,0.9)"   },
  { bg: "rgba(91,127,165,0.15)",  color: "rgba(50,90,140,0.9)"   },
  { bg: "rgba(122,143,110,0.15)", color: "rgba(70,100,60,0.9)"   },
  { bg: "rgba(140,100,170,0.14)", color: "rgba(100,60,140,0.9)"  },
  { bg: "rgba(170,140,60,0.15)",  color: "rgba(120,90,20,0.9)"   },
  { bg: "rgba(170,80,100,0.13)",  color: "rgba(130,45,65,0.9)"   },
  { bg: "rgba(60,150,140,0.14)",  color: "rgba(25,105,95,0.9)"   },
  { bg: "rgba(60,80,150,0.14)",   color: "rgba(30,50,120,0.9)"   },
  { bg: "rgba(130,140,60,0.14)",  color: "rgba(85,95,15,0.9)"    },
  { bg: "rgba(80,130,160,0.14)",  color: "rgba(40,90,130,0.9)"   },
  { bg: "rgba(160,100,60,0.13)",  color: "rgba(120,65,20,0.9)"   },
  { bg: "rgba(100,60,130,0.13)",  color: "rgba(70,30,105,0.9)"   },
];
const allTags = [...new Set(projects.flatMap((p) => p.data.tags))].sort();
const tagColorMap = new Map(allTags.map((tag, i) => [tag, TAG_PALETTES[i % TAG_PALETTES.length]]));
function tagStyle(tag: string) {
  const p = tagColorMap.get(tag) ?? TAG_PALETTES[0];
  return `background:${p.bg};color:${p.color}`;
}

const statusColors: Record<string, string> = {
  Active: "text-sage bg-sage-light/50",
  Completed: "text-sky bg-sky-light/50",
  "Open Source": "text-accent bg-accent-light/30",
  Archived: "text-ink-lighter bg-cream-dark",
};
---

<Base title="Projects — Hitesh">
  <Nav />

  <main class="flex-1">
    <section class="bg-cream">
      <div class="max-w-5xl mx-auto px-6 pt-16 pb-6">
        <div class="mb-2 fade-up">
          <h1 class="font-serif text-3xl font-semibold">Projects</h1>
        </div>
        <p class="text-ink-light fade-up fade-up-delay-1">
          Things I've built, broken, and occasionally finished. Mostly at the intersection of
          robotics and computer vision.
        </p>
      </div>
    </section>

    <section class="bg-warm-white">
      <div class="max-w-5xl mx-auto px-6 py-10">
        <div class="space-y-4">
          {projects.map((project) => (
            <div class="flex gap-3 items-start fade-up">

              <!-- Left: image slideshow card (or glass placeholder if no images) -->
              <a
                href={`/projects/${project.id}`}
                class:list={[
                  "shrink-0 w-32 h-32 rounded-xl overflow-hidden relative hover:-translate-y-0.5 transition-all",
                  project.data.images.length > 0
                    ? "border border-border bg-cream-dark hover:shadow-md"
                    : "glass-demo-card",
                ]}
                tabindex="-1"
                aria-hidden="true"
                data-slideshow={project.data.images.length > 0 ? true : undefined}
              >
                {project.data.images.length > 0 ? (
                  <>
                    {project.data.images.map((img, i) => (
                      <img
                        src={img.src}
                        alt={img.alt}
                        class="absolute inset-0 w-full h-full object-cover transition-opacity duration-700"
                        style={`opacity:${i === 0 ? 1 : 0}`}
                        data-slide
                        loading="lazy"
                      />
                    ))}
                    {project.data.images.length > 1 && (
                      <div class="absolute bottom-1.5 inset-x-0 flex justify-center gap-1 pointer-events-none">
                        {project.data.images.map((_, i) => (
                          <div
                            class="w-1 h-1 rounded-full bg-cream"
                            style={`opacity:${i === 0 ? 0.9 : 0.35}`}
                            data-dot
                          />
                        ))}
                      </div>
                    )}
                  </>
                ) : null}
              </a>

              <!-- Right: project info card — fixed h-32 to match image card -->
              <a
                href={`/projects/${project.id}`}
                class="group flex-1 flex flex-col h-32 border border-border rounded-xl px-5 py-4 bg-cream/50 hover:border-border-dark hover:shadow-md hover:-translate-y-0.5 transition-all overflow-hidden"
              >
                <div class="flex items-start justify-between gap-3 mb-1.5">
                  <h2 class="font-medium text-base leading-snug group-hover:text-accent transition-colors truncate">{project.data.title}</h2>
                  <span
                    class:list={[
                      "text-xs font-medium px-2 py-0.5 rounded-full shrink-0",
                      statusColors[project.data.status] || "text-ink-lighter bg-cream-dark",
                    ]}
                  >
                    {project.data.status}
                  </span>
                </div>
                <p class="text-sm text-ink-light truncate mb-0">{project.data.description}</p>
                <div class="flex items-center justify-between mt-auto">
                  <div class="flex gap-1.5 flex-nowrap overflow-hidden">
                    {project.data.tags.slice(0, 3).map((tag) => (
                      <span class="text-xs font-mono px-2 py-0.5 rounded-md shrink-0" style={tagStyle(tag)}>
                        {tag}
                      </span>
                    ))}
                    {project.data.tags.length > 3 && (
                      <span class="text-xs font-mono px-2 py-0.5 rounded-md shrink-0 bg-cream-dark text-ink-lighter">
                        +{project.data.tags.length - 3}
                      </span>
                    )}
                  </div>
                  <div class="flex items-center gap-3 shrink-0 ml-2">
                    {project.data.demoPath && (
                      <span class="text-xs font-mono px-2 py-0.5 rounded-md bg-accent/10 text-accent border border-accent/20">
                        demo
                      </span>
                    )}
                    <span class="text-xs text-ink-lighter">{project.data.year}</span>
                  </div>
                </div>
              </a>

            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .glass-demo-card {
    background: linear-gradient(
      135deg,
      rgba(250, 247, 242, 0.38) 0%,
      rgba(240, 235, 227, 0.18) 100%
    );
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.55);
    box-shadow:
      0 4px 24px rgba(44, 36, 24, 0.06),
      inset 0 1px 0 rgba(255, 255, 255, 0.7),
      inset 0 -1px 0 rgba(44, 36, 24, 0.04);
  }
  .glass-demo-card:hover {
    box-shadow:
      0 8px 32px rgba(44, 36, 24, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.85),
      inset 0 -1px 0 rgba(44, 36, 24, 0.04);
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) entry.target.classList.add("visible");
      });
    },
    { threshold: 0.1, rootMargin: "0px 0px -50px 0px" }
  );
  document.querySelectorAll(".fade-up").forEach((el) => observer.observe(el));

  // Auto-cycling gallery slideshows on project cards
  document.querySelectorAll("[data-slideshow]").forEach((ss) => {
    const slides = Array.from(ss.querySelectorAll("[data-slide]")) as HTMLElement[];
    const dots = Array.from(ss.querySelectorAll("[data-dot]")) as HTMLElement[];
    if (slides.length <= 1) return;
    let cur = 0;
    setInterval(() => {
      slides[cur].style.opacity = "0";
      if (dots[cur]) dots[cur].style.opacity = "0.35";
      cur = (cur + 1) % slides.length;
      slides[cur].style.opacity = "1";
      if (dots[cur]) dots[cur].style.opacity = "0.9";
    }, 2500);
  });
</script>
