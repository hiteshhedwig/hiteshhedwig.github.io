---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { getEntry, render } from "astro:content";

const aboutEntry = await getEntry("site", "about");
const configEntry = await getEntry("site", "config");
const { Content } = await render(aboutEntry!);
const config = configEntry?.data;
---

<Base title="About — Hitesh">
  <Nav />

  <main class="flex-1">
    <section class="bg-cream">
      <div class="max-w-5xl mx-auto px-6 pt-16 pb-6">
        <div class="mb-2 fade-up">
          <h1 class="font-serif text-3xl font-semibold">About</h1>
        </div>
      </div>
    </section>

    <section class="bg-warm-white">
      <div class="max-w-5xl mx-auto px-6 py-10">
        <div class="max-w-3xl text-ink-light leading-relaxed
          [&_p]:mb-4 [&_strong]:text-ink [&_strong]:font-medium
          [&_a]:text-accent [&_a]:underline [&_a:hover]:text-ink
          fade-up">
          <Content />
        </div>
      </div>
    </section>

    {aboutEntry!.data.facts.length > 0 && (
      <section class="bg-cream">
        <div class="max-w-5xl mx-auto px-6 py-10">
          <div class="bg-paper border border-border rounded-xl p-6 max-w-3xl fade-up">
            <h2 class="font-serif text-lg font-semibold text-ink mb-4">A few things about me</h2>
            <ul class="space-y-2 text-sm">
              {aboutEntry!.data.facts.map((fact) => (
                <li class="flex gap-3">
                  <span class="text-accent shrink-0">&mdash;</span>
                  <span>{fact}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )}

    <section class="bg-warm-white">
      <div class="max-w-5xl mx-auto px-6 py-10">
        <div class="max-w-3xl fade-up">
          <h2 class="font-serif text-xl font-semibold text-ink mb-4">Get in touch</h2>
          <p class="text-ink-light mb-4">
            I love hearing from people working on interesting problems. Whether you want to
            collaborate, chat about robotics, or just say hello — feel free to reach out.
          </p>

          {config?.socials && config.socials.length > 0 && (
            <div class="flex flex-wrap gap-3">
              {config.socials.map((s) => (
                <a
                  href={s.href}
                  class="px-4 py-2 border border-border-dark rounded-lg text-sm text-ink-light hover:text-accent hover:border-accent hover:-translate-y-0.5 hover:shadow-md transition-all"
                >
                  {s.label}
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) entry.target.classList.add("visible");
      });
    },
    { threshold: 0.1, rootMargin: "0px 0px -50px 0px" }
  );
  document.querySelectorAll(".fade-up").forEach((el) => observer.observe(el));
</script>
