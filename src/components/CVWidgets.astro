---
// CV / geometry doodles for the hero. All vector, monochrome with a single
// orange accent. Each widget is positioned absolutely into the hero's empty
// space; the parent must be `position: relative` and tall enough.
---

<!-- Right-of-headline cluster: epipolar + RANSAC -->
<div
  class="hidden md:flex absolute top-4 right-6 lg:right-10 w-[300px] flex-col gap-3 pointer-events-none select-none"
  aria-hidden="true"
>
  <svg id="cv-epipolar" width="300" height="180" class="block">
    <text x="6" y="14" font-size="9" font-family="JetBrains Mono, monospace"
          fill="#999" letter-spacing="1">epipolar · F·x₁=l₂</text>
  </svg>

  <div class="self-end">
    <svg id="cv-ransac" width="220" height="150" class="block">
      <text x="6" y="14" font-size="9" font-family="JetBrains Mono, monospace"
            fill="#999" letter-spacing="1">ransac · k=0</text>
    </svg>
  </div>
</div>

<!-- Bottom-right of hero: Delaunay -->
<div
  class="hidden md:block absolute bottom-6 right-6 lg:right-10 opacity-95 pointer-events-none select-none"
  aria-hidden="true"
>
  <svg id="cv-delaunay" width="170" height="150" class="block">
    <text x="6" y="14" font-size="9" font-family="JetBrains Mono, monospace"
          fill="#999" letter-spacing="1">delaunay</text>
  </svg>
</div>

<!-- Telemetry strip — placed inline where the slot is rendered -->
<div
  id="cv-telemetry"
  class="mt-7 pt-3.5 border-t border-dashed border-ink/15 max-w-[460px] flex flex-wrap gap-x-6 gap-y-1 font-mono text-[10px] text-ink-lighter"
  aria-hidden="true"
>
  <div class="flex items-center gap-1.5"><span class="text-ink-lighter/60">cpu</span><span data-cv="cpu">38.0</span>%</div>
  <div class="flex items-center gap-1.5"><span class="text-ink-lighter/60">fps</span><span data-cv="fps">29.0</span></div>
  <div class="flex items-center gap-1.5"><span class="text-ink-lighter/60">drift</span><span data-cv="drift">0.012</span>m</div>
  <div class="flex items-center gap-1.5">
    <span class="text-ink-lighter/60">up</span>
    <span class="cv-breathe inline-block w-1.5 h-1.5 rounded-full" style="background:#7a8f6e"></span>
  </div>
</div>

<!-- Bezier strip (lives below telemetry) -->
<div class="mt-5 max-w-[460px] opacity-95">
  <svg id="cv-bezier" width="100%" height="50" viewBox="0 0 460 50" preserveAspectRatio="none" class="block"></svg>
</div>

<style is:global>
  @keyframes cv-breathe { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
  .cv-breathe { animation: cv-breathe 3s ease-in-out infinite; }

  @keyframes cv-scrub { from { left: 0%; } to { left: 100%; } }
  .cv-scrub-head { animation: cv-scrub 9s linear infinite; }

  @keyframes cv-capture {
    0%   { opacity: 0; transform: scale(1.05); }
    15%  { opacity: 1; transform: scale(1); }
    85%  { opacity: 1; }
    100% { opacity: 0; }
  }
  .cv-capture-box {
    position: absolute;
    pointer-events: none;
    border: 1px dashed var(--color-accent);
    border-radius: 2px;
    animation: cv-capture 1.4s ease forwards;
  }
  .cv-capture-box .cv-capture-label {
    position: absolute;
    top: -16px;
    left: 0;
    font-family: "JetBrains Mono", monospace;
    font-size: 9px;
    color: var(--color-accent);
    white-space: nowrap;
    letter-spacing: 0.5px;
  }
</style>

<script>
  // ---- Telemetry strip (cpu / fps / drift) ----
  (() => {
    const cpuEl = document.querySelector<HTMLElement>('[data-cv="cpu"]');
    const fpsEl = document.querySelector<HTMLElement>('[data-cv="fps"]');
    const driftEl = document.querySelector<HTMLElement>('[data-cv="drift"]');
    if (!cpuEl) return;
    let t = 0;
    setInterval(() => {
      t++;
      const cpu = 38 + Math.sin(t / 8) * 6 + Math.sin(t / 3) * 2;
      const fps = 29 + Math.sin(t / 12) * 1.5;
      const drift = 0.012 + Math.sin(t / 20) * 0.004;
      cpuEl.textContent = cpu.toFixed(1);
      fpsEl!.textContent = fps.toFixed(1);
      driftEl!.textContent = drift.toFixed(3);
    }, 100);
  })();

  // ---- Epipolar geometry ----
  (() => {
    const svg = document.getElementById('cv-epipolar') as SVGSVGElement | null;
    if (!svg) return;
    const W = 300, H = 180;
    const NS = 'http://www.w3.org/2000/svg';
    const baseGroup = document.createElementNS(NS, 'g');
    svg.appendChild(baseGroup);

    let t = 0;
    const draw = () => {
      while (baseGroup.firstChild) baseGroup.removeChild(baseGroup.firstChild);
      const phase = t / 50;
      const Px = Math.cos(phase) * 0.6;
      const Pz = 1.6 + Math.sin(phase * 0.7) * 0.2;
      const proj = (x: number, z: number) => ({ x: W/2 + x*80, y: H - 30 - z*60 });
      const C1 = -0.8, C2 = 0.8;
      const f = (cx: number) => ({
        cx: W/2 + cx*80, cy: H - 30,
        ax: W/2 + cx*80 - 22, ay: H - 30 - 30,
        bx: W/2 + cx*80 + 22, by: H - 30 - 30,
      });
      const f1 = f(C1), f2 = f(C2);
      const Pp = proj(Px, Pz);
      const projectOn = (cx: number) => {
        const c = f(cx);
        const ratio = (c.ay - c.cy) / (Pp.y - c.cy);
        return { x: c.cx + (Pp.x - c.cx) * ratio, y: c.ay };
      };
      const im1 = projectOn(C1), im2 = projectOn(C2);

      const line = (x1: number, y1: number, x2: number, y2: number, opts: Record<string, string>) => {
        const l = document.createElementNS(NS, 'line');
        l.setAttribute('x1', String(x1)); l.setAttribute('y1', String(y1));
        l.setAttribute('x2', String(x2)); l.setAttribute('y2', String(y2));
        for (const k in opts) l.setAttribute(k, opts[k]);
        baseGroup.appendChild(l);
      };
      const circle = (cx: number, cy: number, r: number, opts: Record<string, string>) => {
        const c = document.createElementNS(NS, 'circle');
        c.setAttribute('cx', String(cx)); c.setAttribute('cy', String(cy)); c.setAttribute('r', String(r));
        for (const k in opts) c.setAttribute(k, opts[k]);
        baseGroup.appendChild(c);
      };

      // baseline
      line(f1.cx, f1.cy, f2.cx, f2.cy, { stroke: '#1a1a1a', 'stroke-width': '0.6', opacity: '0.25', 'stroke-dasharray': '2 3' });
      // frusta
      [f1, f2].forEach((fr) => {
        line(fr.cx, fr.cy, fr.ax, fr.ay, { stroke: '#1a1a1a', 'stroke-width': '0.8', opacity: '0.55' });
        line(fr.cx, fr.cy, fr.bx, fr.by, { stroke: '#1a1a1a', 'stroke-width': '0.8', opacity: '0.55' });
        line(fr.ax, fr.ay, fr.bx, fr.by, { stroke: '#1a1a1a', 'stroke-width': '0.8', opacity: '0.55' });
        circle(fr.cx, fr.cy, 2.5, { fill: '#1a1a1a' });
      });
      // rays C→P
      line(f1.cx, f1.cy, Pp.x, Pp.y, { stroke: '#c45d3e', 'stroke-width': '0.7', opacity: '0.55' });
      line(f2.cx, f2.cy, Pp.x, Pp.y, { stroke: '#c45d3e', 'stroke-width': '0.7', opacity: '0.55' });
      // image points
      circle(im1.x, im1.y, 2, { fill: '#c45d3e' });
      circle(im2.x, im2.y, 2, { fill: '#c45d3e' });
      // P
      circle(Pp.x, Pp.y, 3, { fill: '#c45d3e' });
      circle(Pp.x, Pp.y, 6, { fill: 'none', stroke: '#c45d3e', 'stroke-width': '0.5', opacity: '0.5' });
      // epipolar line on right image
      line(f2.ax, f2.ay, f2.bx, f2.by, { stroke: '#c45d3e', 'stroke-width': '1.2', opacity: '0.7' });

      t++;
    };
    draw();
    setInterval(draw, 60);
  })();

  // ---- RANSAC ----
  (() => {
    const svg = document.getElementById('cv-ransac') as SVGSVGElement | null;
    if (!svg) return;
    const W = 220, H = 150;
    const NS = 'http://www.w3.org/2000/svg';
    const label = svg.querySelector('text');
    const group = document.createElementNS(NS, 'g');
    svg.appendChild(group);

    const m = -0.45, b = H * 0.75;
    const points = Array.from({ length: 28 }, () => {
      const x = 20 + Math.random() * (W - 40);
      const onLine = Math.random() < 0.72;
      const y = onLine ? m * x + b + (Math.random() - 0.5) * 14 : Math.random() * (H - 40) + 20;
      return { x, y, inlier: onLine };
    });

    let iter = 0;
    let sample: [number, number] = [0, 1];
    const inlierIdx = points.map((p, i) => p.inlier ? i : -1).filter(i => i >= 0);
    const pickSample = () => {
      const a = Math.random() < 0.6 ? inlierIdx[Math.floor(Math.random() * inlierIdx.length)] : Math.floor(Math.random() * points.length);
      let bb;
      do {
        bb = Math.random() < 0.6 ? inlierIdx[Math.floor(Math.random() * inlierIdx.length)] : Math.floor(Math.random() * points.length);
      } while (bb === a);
      sample = [a, bb];
    };

    const draw = () => {
      while (group.firstChild) group.removeChild(group.firstChild);
      if (label) label.textContent = `ransac · k=${iter}`;
      const a = points[sample[0]], bb = points[sample[1]];
      const dx = bb.x - a.x, dy = bb.y - a.y;
      const len = Math.hypot(dx, dy) || 1;
      const y1 = a.y + (0 - a.x) * dy / dx;
      const y2 = a.y + (W - a.x) * dy / dx;
      const thr = 10;

      const mk = (tag: string, attrs: Record<string, string>) => {
        const el = document.createElementNS(NS, tag);
        for (const k in attrs) el.setAttribute(k, attrs[k]);
        group.appendChild(el);
        return el;
      };

      mk('line', { x1: '0', y1: String(y1), x2: String(W), y2: String(y2), stroke: '#c45d3e', 'stroke-width': '1', opacity: '0.6', 'stroke-dasharray': '4 3' });
      mk('line', { x1: '0', y1: String(y1 - thr), x2: String(W), y2: String(y2 - thr), stroke: '#c45d3e', 'stroke-width': '0.4', opacity: '0.18', 'stroke-dasharray': '2 3' });
      mk('line', { x1: '0', y1: String(y1 + thr), x2: String(W), y2: String(y2 + thr), stroke: '#c45d3e', 'stroke-width': '0.4', opacity: '0.18', 'stroke-dasharray': '2 3' });

      points.forEach((p, i) => {
        const isInlier = Math.abs((dx * (a.y - p.y) - (a.x - p.x) * dy)) / len < thr;
        const sampled = i === sample[0] || i === sample[1];
        if (sampled) {
          const ring = mk('circle', { cx: String(p.x), cy: String(p.y), r: '6', fill: 'none', stroke: '#c45d3e', 'stroke-width': '0.8' });
          const a1 = document.createElementNS(NS, 'animate');
          a1.setAttribute('attributeName', 'r'); a1.setAttribute('values', '3;9;3');
          a1.setAttribute('dur', '1.1s'); a1.setAttribute('repeatCount', 'indefinite');
          ring.appendChild(a1);
          const a2 = document.createElementNS(NS, 'animate');
          a2.setAttribute('attributeName', 'opacity'); a2.setAttribute('values', '0.7;0;0.7');
          a2.setAttribute('dur', '1.1s'); a2.setAttribute('repeatCount', 'indefinite');
          ring.appendChild(a2);
        }
        mk('circle', { cx: String(p.x), cy: String(p.y), r: '2', fill: isInlier ? '#1a1a1a' : '#bbb', opacity: isInlier ? '0.7' : '0.5' });
        if (!isInlier) mk('circle', { cx: String(p.x), cy: String(p.y), r: '4', fill: 'none', stroke: '#bbb', 'stroke-width': '0.4', opacity: '0.6' });
      });
    };

    pickSample();
    draw();
    setInterval(() => {
      iter++;
      if (iter % 3 === 0) pickSample();
      draw();
    }, 1100);
  })();

  // ---- Bezier ----
  (() => {
    const svg = document.getElementById('cv-bezier') as SVGSVGElement | null;
    if (!svg) return;
    const W = 460, H = 50;
    const NS = 'http://www.w3.org/2000/svg';
    let t = 0;
    const tick = () => {
      while (svg.firstChild) svg.removeChild(svg.firstChild);
      const phase = t / 30;
      const P0 = { x: 10, y: H/2 + Math.sin(phase) * 6 };
      const P1 = { x: W * 0.33, y: 8 + Math.sin(phase + 1) * 4 };
      const P2 = { x: W * 0.66, y: H - 8 + Math.sin(phase + 2) * 4 };
      const P3 = { x: W - 10, y: H/2 + Math.sin(phase + 3) * 6 };
      const u = (t % 200) / 200;
      const bez = (uu: number) => {
        const um = 1 - uu;
        return {
          x: um*um*um*P0.x + 3*um*um*uu*P1.x + 3*um*uu*uu*P2.x + uu*uu*uu*P3.x,
          y: um*um*um*P0.y + 3*um*um*uu*P1.y + 3*um*uu*uu*P2.y + uu*uu*uu*P3.y,
        };
      };
      const samples = 60;
      const drawnEnd = Math.floor(samples * u);
      let path = `M ${P0.x} ${P0.y}`;
      for (let i = 1; i <= drawnEnd; i++) { const p = bez(i/samples); path += ` L ${p.x} ${p.y}`; }
      let ghost = `M ${P0.x} ${P0.y}`;
      for (let i = 1; i <= samples; i++) { const p = bez(i/samples); ghost += ` L ${p.x} ${p.y}`; }
      const head = bez(u);

      const mk = (tag: string, attrs: Record<string, string>) => {
        const el = document.createElementNS(NS, tag);
        for (const k in attrs) el.setAttribute(k, attrs[k]);
        svg.appendChild(el);
      };
      mk('polyline', {
        points: `${P0.x},${P0.y} ${P1.x},${P1.y} ${P2.x},${P2.y} ${P3.x},${P3.y}`,
        fill: 'none', stroke: '#1a1a1a', 'stroke-width': '0.5', 'stroke-dasharray': '2 3', opacity: '0.2',
      });
      [P0, P1, P2, P3].forEach(p => mk('circle', { cx: String(p.x), cy: String(p.y), r: '1.5', fill: '#1a1a1a', opacity: '0.4' }));
      mk('path', { d: ghost, fill: 'none', stroke: '#1a1a1a', 'stroke-width': '0.4', opacity: '0.12' });
      mk('path', { d: path, fill: 'none', stroke: '#c45d3e', 'stroke-width': '1.2', opacity: '0.7', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' });
      mk('circle', { cx: String(head.x), cy: String(head.y), r: '2.5', fill: '#c45d3e' });
      t++;
    };
    tick();
    setInterval(tick, 30);
  })();

  // ---- Delaunay ----
  (() => {
    const svg = document.getElementById('cv-delaunay') as SVGSVGElement | null;
    if (!svg) return;
    const W = 170, H = 150;
    const NS = 'http://www.w3.org/2000/svg';
    const seeds = Array.from({ length: 14 }, () => ({
      x: 18 + Math.random() * (W - 36),
      y: 18 + Math.random() * (H - 36),
    }));
    const edges: { a: number; b: number }[] = [];
    seeds.forEach((s, i) => {
      const near = seeds.map((o, j) => ({ j, d: Math.hypot(s.x - o.x, s.y - o.y) }))
        .filter(e => e.j !== i).sort((a, b) => a.d - b.d).slice(0, 3);
      near.forEach(({ j }) => {
        const aa = Math.min(i, j), bb = Math.max(i, j);
        if (!edges.find(e => e.a === aa && e.b === bb)) edges.push({ a: aa, b: bb });
      });
    });
    const mk = (tag: string, attrs: Record<string, string>) => {
      const el = document.createElementNS(NS, tag);
      for (const k in attrs) el.setAttribute(k, attrs[k]);
      svg.appendChild(el);
      return el;
    };
    edges.forEach((e, i) => {
      const A = seeds[e.a], B = seeds[e.b];
      const ln = mk('line', { x1: String(A.x), y1: String(A.y), x2: String(B.x), y2: String(B.y), stroke: '#1a1a1a', 'stroke-width': '0.5', opacity: '0.18' });
      const an = document.createElementNS(NS, 'animate');
      an.setAttribute('attributeName', 'stroke-dasharray');
      an.setAttribute('values', '0 200; 200 0; 200 0');
      an.setAttribute('keyTimes', '0;0.4;1');
      an.setAttribute('dur', `${4 + (i % 5)}s`);
      an.setAttribute('begin', `${(i % 7) * 0.3}s`);
      an.setAttribute('repeatCount', 'indefinite');
      ln.appendChild(an);
    });
    seeds.forEach((s, i) => mk('circle', {
      cx: String(s.x), cy: String(s.y), r: '2',
      fill: i === 0 ? '#c45d3e' : '#1a1a1a',
      opacity: i === 0 ? '0.9' : '0.5',
    }));
  })();

  // ---- Capture bbox cycle on the headline verbs ----
  (() => {
    const cycleWord = (el: HTMLElement, label: string, conf: number) => {
      const parent = el.offsetParent as HTMLElement | null;
      if (!parent) return;
      const r = el.getBoundingClientRect();
      const pr = parent.getBoundingClientRect();
      const box = document.createElement('span');
      box.className = 'cv-capture-box';
      box.style.left = `${r.left - pr.left - 4}px`;
      box.style.top = `${r.top - pr.top - 4}px`;
      box.style.width = `${r.width + 8}px`;
      box.style.height = `${r.height + 8}px`;
      const lab = document.createElement('span');
      lab.className = 'cv-capture-label';
      lab.textContent = `${label} ${conf.toFixed(2)}`;
      box.appendChild(lab);
      parent.appendChild(box);
      setTimeout(() => box.remove(), 1400);
    };

    const start = () => {
      const verbs: { id: string; label: string; conf: number; delay: number }[] = [
        { id: 'cv-verb-see', label: 'verb_motion', conf: 0.94, delay: 1500 },
        { id: 'cv-verb-think', label: 'cognition', conf: 0.81, delay: 4500 },
        { id: 'cv-verb-move', label: 'motion_vec', conf: 0.97, delay: 7500 },
      ];
      verbs.forEach(v => {
        const fire = () => {
          const el = document.getElementById(v.id);
          if (el) cycleWord(el, v.label, v.conf);
        };
        setTimeout(() => { fire(); setInterval(fire, 11000); }, v.delay);
      });
    };

    // Wait for the typewriter to finish before bbox-capturing (it injects the verb spans)
    const wait = () => {
      if (document.getElementById('cv-verb-see')) start();
      else setTimeout(wait, 200);
    };
    wait();
  })();
</script>
