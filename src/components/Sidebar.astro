---
import { getEntry } from "astro:content";

const configEntry = await getEntry("site", "config");
const config = configEntry?.data;
---

<aside class="lg:w-56 shrink-0 space-y-5">
  {config?.status && (
    <div class="bg-warm-white border border-border rounded-xl p-4">
      <h3 class="text-xs font-mono text-ink-lighter uppercase tracking-wider mb-2 flex items-center justify-between">
        <span>Status · live</span>
      </h3>
      <p class="text-sm text-ink-light leading-snug mb-2">{config.status}</p>
      <svg id="cv-waveform" width="100%" height="20" class="block" aria-hidden="true"></svg>
    </div>
  )}

  {config?.currentlyReading && (
    <div class="bg-warm-white border border-border rounded-xl p-4">
      <h3 class="text-xs font-mono text-ink-lighter uppercase tracking-wider mb-2">Reading · est.</h3>
      <p class="text-sm font-medium text-ink">{config.currentlyReading.title}</p>
      <p class="text-xs text-ink-lighter">{config.currentlyReading.author}</p>
      <div
        class="mt-2 h-1 bg-ink/[0.06] rounded-sm relative overflow-hidden"
        data-cv-kalman
        data-progress={config.currentlyReading.progress}
        aria-hidden="true"
      >
        <div data-cv-kalman-band class="absolute inset-y-0 bg-accent/25"></div>
        <div data-cv-kalman-mean class="absolute inset-y-0 w-0.5 bg-accent"></div>
      </div>
      <p class="text-[10px] font-mono text-ink-lighter mt-1 flex justify-between">
        <span data-cv-kalman-est>ch. {(config.currentlyReading.progress / 100 * 12).toFixed(1)} ± 0.5</span>
        <span>{config.currentlyReading.progress}%</span>
      </p>
    </div>
  )}

  <script>
    // Status waveform
    (() => {
      const svg = document.getElementById('cv-waveform') as SVGSVGElement | null;
      if (!svg) return;
      const NS = 'http://www.w3.org/2000/svg';
      const N = 40, step = 4.4;
      svg.setAttribute('viewBox', `0 0 ${N * step} 20`);
      svg.setAttribute('preserveAspectRatio', 'none');
      for (let i = 0; i < N; i++) {
        const baseH = 2 + Math.abs(Math.sin(i * 1.3)) * 8;
        const rect = document.createElementNS(NS, 'rect');
        rect.setAttribute('x', String(i * step));
        rect.setAttribute('width', '2');
        rect.setAttribute('fill', '#c45d3e');
        rect.setAttribute('opacity', '0.45');
        rect.setAttribute('y', String(10 - baseH / 2));
        rect.setAttribute('height', String(baseH));
        const peak = 1 + Math.random() * 14;
        const dur = `${1.2 + (i % 7) * 0.2}s`;
        const a1 = document.createElementNS(NS, 'animate');
        a1.setAttribute('attributeName', 'height');
        a1.setAttribute('values', `${baseH};${peak};${baseH}`);
        a1.setAttribute('dur', dur);
        a1.setAttribute('repeatCount', 'indefinite');
        rect.appendChild(a1);
        const a2 = document.createElementNS(NS, 'animate');
        a2.setAttribute('attributeName', 'y');
        a2.setAttribute('values', `${10 - baseH/2};${10 - peak/2};${10 - baseH/2}`);
        a2.setAttribute('dur', dur);
        a2.setAttribute('repeatCount', 'indefinite');
        rect.appendChild(a2);
        svg.appendChild(rect);
      }
    })();

    // Kalman band — mean breathes around configured progress, with ± uncertainty
    (() => {
      const root = document.querySelector<HTMLElement>('[data-cv-kalman]');
      if (!root) return;
      const target = parseFloat(root.dataset.progress || '0');
      const band = root.querySelector<HTMLElement>('[data-cv-kalman-band]')!;
      const mean = root.querySelector<HTMLElement>('[data-cv-kalman-mean]')!;
      const est = document.querySelector<HTMLElement>('[data-cv-kalman-est]');
      setInterval(() => {
        const p = target + Math.sin(Date.now() / 3000) * 1.5;
        const unc = 2 + Math.sin(Date.now() / 1500) * 1;
        band.style.left = `${Math.max(0, p - unc)}%`;
        band.style.width = `${unc * 2}%`;
        mean.style.left = `${p}%`;
        if (est) est.textContent = `ch. ${(p / 100 * 12).toFixed(1)} ± ${(unc / 100 * 12).toFixed(1)}`;
      }, 200);
    })();
  </script>

  {config?.quickLinks && config.quickLinks.length > 0 && (
    <div class="bg-warm-white border border-border rounded-xl p-4">
      <h3 class="text-xs font-mono text-ink-lighter uppercase tracking-wider mb-2">Quick links</h3>
      <ul class="space-y-1.5 text-sm">
        {config.quickLinks.map((link) => (
          <li><a href={link.href} class="text-ink-light hover:text-accent transition-colors">&rsaquo; {link.label}</a></li>
        ))}
      </ul>
    </div>
  )}

  {config?.randomThought && (
    <div class="bg-paper border border-dashed border-border-dark rounded-xl p-4">
      <h3 class="text-xs font-mono text-accent uppercase tracking-wider mb-2">Random thought</h3>
      <p class="text-sm text-ink-light italic font-serif leading-relaxed">
        {config.randomThought}
      </p>
    </div>
  )}
</aside>
