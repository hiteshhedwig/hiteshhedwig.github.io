---
const year = new Date().getFullYear();
---

<footer class="border-t border-border mt-auto">
  <div class="max-w-3xl mx-auto px-6 py-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-ink-lighter">
      <p class="font-serif italic">"Stay curious, build things, share what you learn."</p>
      <div class="flex gap-4">
        <a href="https://github.com" class="hover:text-accent transition-colors">GitHub</a>
        <a href="https://twitter.com" class="hover:text-accent transition-colors">Twitter</a>
        <a href="mailto:hello@hitesh.one" class="hover:text-accent transition-colors">Email</a>
      </div>
    </div>
    <p class="text-center text-xs text-ink-lighter mt-4">&copy; {year} Hitesh. Made with care.</p>
  </div>
</footer>
